# Copy this file to .env and fill in real values. .env is gitignored.
#
# THIS FILE IS COMMITTED TO GIT. Never put a real key here — put it in .env.
# Placeholders only.

# Ollagraph API — primary engine for discovery, crawling, and extraction.
# Docs: https://ollagraph.com/docs/
OLLAGRAPH_API_KEY=

# Hard ceiling on credits a single pipeline run may spend. Exceeding it aborts
# the run. Costs are NOT uniform: /v1/search observed at 3 credits/call, the
# gmaps actors at 30. The cap may overshoot by one call's cost.
OLLAGRAPH_CREDIT_CAP=5000

# Backend — plain filesystem path to the SQLite file (stdlib sqlite3, no ORM)
DATABASE_PATH=./colleges.db

# CORS: the known frontend origin. Never set this to "*".
FRONTEND_ORIGIN=http://localhost:3000
